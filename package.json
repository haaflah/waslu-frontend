{
  "name": "waslu-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node init && turbo run dev --parallel",
    "build": "node init && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:strings": "node ./scripts/check-hardcoded-strings.mjs",
    "regen:api": "pnpm --filter @waslu/api-client run generate",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "autoprefixer": "^10.4.21"
  }
}
