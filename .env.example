# Copy this file to apps/storefront/.env.local and apps/seller/.env.local
# (Next.js reads .env.local from the app folder, not from the repo root).

# "mock" uses built-in fake data. "live" calls the real backend.
NEXT_PUBLIC_API_MODE=mock

# Backend address, only used when NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
