{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "pnpm --filter @waslu/storefront start",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3000"],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
